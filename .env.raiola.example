# =============================================================================
# Tu Gestión Legal — variables para Raiola Hosting Code (producción)
# Copiar a .env en el servidor (cPanel / SSH). NUNCA commitear valores reales.
# Migración: BD limpia (sin dump de Railway). Schema vía drizzle-kit migrate.
# =============================================================================

# --- Obligatorias ---
DATABASE_URL=mysql://USUARIO:PASSWORD@localhost:3306/NOMBRE_BD
JWT_SECRET=generar-string-largo-aleatorio-nuevo
NODE_ENV=production
# Puerto que asigne Setup Node.js / Application Manager en cPanel
PORT=3000
# Primero URL temporal Raiola; tras DNS: https://www.tugestionlegal.es
PUBLIC_APP_URL=https://SU_URL_TEMPORAL_RAIOLA

# --- Admin (seed al arranque si no existe) ---
ADMIN_EMAIL=info@tugestionlegal.es
ADMIN_PASSWORD=cambiar-por-password-fuerte
ADMIN_NAME=Administrador
# ADMIN_RESET_PASSWORD=true

# --- Email (SMTP del hosting Raiola; preferido frente a Resend) ---
SMTP_USER=info@tugestionlegal.es
SMTP_PASS=
EMAIL_FROM=Tu Gestión Legal <info@tugestionlegal.es>
ADMIN_NOTIFY_EMAIL=info@tugestionlegal.es
# RESEND_API_KEY=   # solo si quiere respaldo; con SMTP Raiola no hace falta

# --- Jobs HTTP opcionales (timers internos ya corren en el proceso) ---
CRON_SECRET=generar-secret-de-cron

# --- Stripe (test primero; live tras smoke) ---
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook final: https://www.tugestionlegal.es/api/stripe/webhook
# Eventos: checkout.session.completed, checkout.session.expired
# Nota: cambiar VITE_* exige rebuild (pnpm build)

# --- Storage: en Raiola el disco uploads/ persiste; S3 opcional ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=eu-west-1
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# --- Analytics / Places (opcionales) ---
VITE_GA_MEASUREMENT_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJM_DeDM_wpw8RHUzVPD9E8Vg
GOOGLE_WRITE_REVIEW_URL=https://g.page/r/CR1M1Tw_RPFYEBM/review
