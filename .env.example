# =============================================================================
# Tu Gestión Legal — plantilla de variables de entorno
# Copiar a .env y rellenar. NUNCA commitear .env con valores reales.
# Fuente de valores: "Variables de Entorno y Secretos" / docx de secretos (privado).
# =============================================================================

# --- Obligatorias para arranque local (Fase 1) ---
DATABASE_URL=mysql://tgl:tgl_secret@127.0.0.1:3306/tu_gestion_legal
JWT_SECRET=cambiar-por-string-largo-aleatorio
NODE_ENV=development
PORT=3000

# --- Email (reservas / contacto / newsletter) ---
SMTP_USER=
SMTP_PASS=

# --- Admin local (email + password) ---
ADMIN_EMAIL=info@tugestionlegal.es
ADMIN_PASSWORD=cambiar-en-local
ADMIN_NAME=Administrador
# En producción: solo crear si no existe. Para forzar cambio de password:
# ADMIN_RESET_PASSWORD=true

# --- Auth admin Manus OAuth (legacy; opcional) ---
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# --- APIs internas Manus (no disponibles fuera de Manus; dejar vacío en local) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Stripe (Fase 4 — opcional ahora; solo test) ---
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics / Google Places ---
VITE_GA_MEASUREMENT_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJM_DeDM_wpw8RHUzVPD9E8Vg
GOOGLE_WRITE_REVIEW_URL=https://g.page/r/CR1M1Tw_RPFYEBM/review

