# =============================================================================
# Tu Gestión Legal — plantilla de variables de entorno
# Copiar a .env y rellenar. NUNCA commitear .env con valores reales.
# =============================================================================

# --- Obligatorias para arranque local ---
DATABASE_URL=mysql://tgl:tgl_secret@127.0.0.1:3306/tu_gestion_legal
JWT_SECRET=cambiar-por-string-largo-aleatorio
NODE_ENV=development
PORT=3000
# URL pública (enlaces absolutos a /uploads, emails). Ej: http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Email ---
# Producción en Railway Trial/Hobby: usar Resend (HTTPS). SMTP está bloqueado.
RESEND_API_KEY=
# Remitente verificado en Resend (dominio tugestionlegal.es) o beth.t@example.com en pruebas
EMAIL_FROM=Tu Gestión Legal <info@tugestionlegal.es>
ADMIN_NOTIFY_EMAIL=info@tugestionlegal.es
# Local opcional (Gmail app password) — no funciona en Railway Trial
SMTP_USER=
SMTP_PASS=

# --- Admin local (email + password) — auth primaria ---
ADMIN_EMAIL=info@tugestionlegal.es
ADMIN_PASSWORD=cambiar-en-local
ADMIN_NAME=Administrador
# En producción: solo crear si no existe. Para forzar cambio de password:
# ADMIN_RESET_PASSWORD=true

# --- Jobs programados (HTTP). Timers internos funcionan sin esto. ---
# POST /api/scheduled/sendReminders  Header: Authorization: Bearer <CRON_SECRET>
# POST /api/scheduled/sendNewsletter
CRON_SECRET=cambiar-por-secret-de-cron

# --- Storage: S3/R2 (opcional). Sin esto → disco local ./uploads ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=eu-west-1
# S3_ENDPOINT=           # R2/MinIO; vacío = AWS
# S3_PUBLIC_URL=         # CDN/base pública; vacío = signed URLs

# --- Auth Manus OAuth (legacy; dejar vacío fuera de Manus) ---
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# --- APIs Manus Forge (legacy; no requeridas) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Stripe (Fase 4 — Checkout asesorías) ---
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: POST /api/stripe/webhook

# --- Analytics / Google Places ---
VITE_GA_MEASUREMENT_ID=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJM_DeDM_wpw8RHUzVPD9E8Vg
GOOGLE_WRITE_REVIEW_URL=https://g.page/r/CR1M1Tw_RPFYEBM/review
